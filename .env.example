VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
DATA_ACCESS_PASSWORD=replace-with-a-private-passphrase-at-least-16-characters
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DEV_DB_URL=postgresql://postgres:your-database-password@db.your-development-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DEV_PROJECT_REF=your-development-project-ref
LOCAL_AUTH_BYPASS=false
