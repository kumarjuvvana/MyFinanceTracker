{
  "rewrites": [
    {
      "source": "/api/stock-price",
      "destination": "/api/market-data?handler=stock"
    },
    {
      "source": "/api/mutual-fund-nav",
      "destination": "/api/market-data?handler=mutual-fund-nav"
    },
    {
      "source": "/api/nps-nav",
      "destination": "/api/market-data?handler=nps-nav"
    },
    {
      "source": "/api/gold-price",
      "destination": "/api/market-data?handler=gold-price"
    },
    {
      "source": "/api/gmail-oauth",
      "destination": "/api/gmail?handler=oauth"
    },
    {
      "source": "/api/gmail-oauth-callback",
      "destination": "/api/gmail?handler=callback"
    },
    {
      "source": "/api/gmail-schedules",
      "destination": "/api/gmail?handler=schedules"
    }
  ],
  "crons": [
    {
      "path": "/api/asset-prices",
      "schedule": "30 17 * * 5"
    }
  ],
  "functions": {
    "api/asset-prices.ts": {
      "maxDuration": 60
    },
    "api/gmail.ts": {
      "maxDuration": 60
    }
  }
}
